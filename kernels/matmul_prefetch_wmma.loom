  %valid=index.cmp ult,%row,%rows : index
  scf.if %valid {
   %bound=index.assume %row [range(%row,0,1048559),lt(%row,%rows)] : index
   %v=vector.load %result[%pr,%pc] : view<16x16xf32> -> vector<4xf32>
   scf.if %is_gelu {
    %b=vector.addf %v,%bias_values : vector<4xf32>
    %act=vector.geluf<erf> %b : vector<4xf32>
    %narrow=vector.fptrunc %act : vector<4xf32> to vector<4xf16>
    %half_base=index.mul %bound,%ns : index
    %half_index0=index.add %half_base,%col : index
    %half_index=index.assume %half_index0 [range(%half_index0,0,2147483643),mul(%half_index0,4),le(%half_index0,%half_limit)] : index
    vector.store %narrow,%ov_half[%half_index] : vector<4xf16>,view<[%half_elements]xf16>
   } else {
    %value=scf.if %is_split -> (vector<4xf32>) {
     scf.yield %v : vector<4xf32>
    } else {
     %b=vector.addf %v,%bias_values : vector<4xf32>
     scf.yield %b : vector<4xf32>
    }
    %outrow0=index.add %bound,%slab : index
    %outrow=index.assume %outrow0 [range(%outrow0,0,4194239), lt(%outrow0,%partial_capacity), lt(%outrow0,%out_rows)] : index
    %out_base=index.mul %outrow,%ns : index
    %out_index0=index.add %out_base,%col : index
    %out_index=index.assume %out_index0 [range(%out_index0,0,1073741819),mul(%out_index0,4),le(%out_index0,%out_limit)] : index
    %updated=scf.if %is_resid -> (vector<4xf32>) {
     %prior=vector.load %ov[%out_index] : view<[%out_elements]xf32> -> vector<4xf32>
     %scale=vector.load %lv[%col] : view<[%ns]xf32> -> vector<4xf32>
     %scaled=vector.mulf %value,%scale : vector<4xf32>
     %sum=vector.addf %prior,%scaled : vector<4xf32>
     scf.yield %sum : vector<4xf32>
    } else { scf.yield %value : vector<4xf32> }
    vector.store %updated,%ov[%out_index] : vector<4xf32>,view<[%out_elements]xf32>
   }
  }
 }
 kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
 }
 kernel.return
}

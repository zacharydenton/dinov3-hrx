config.decl @dinov3.matmul_wide_wmma.splits : %value: index where [range(%value,1,4)]
config.decl @dinov3.matmul_wide_wmma.epilogue : %value: index where [range(%value,0,2)]
config.decl @dinov3.matmul_wide_wmma.tile_rows : %value: index where [range(%value,128,256),mul(%value,128)]
